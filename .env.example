# Server only. Never prefix private provider keys with VITE_.
NODE_ENV=development
PORT=3000
ADMIN_EMAIL=admin@example.com
MAIL_FROM=Portfolio <contact@your-verified-domain.example>
RESEND_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Exact origins only; add individually approved Cloudflare preview URLs here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set only after confirming the number of trusted reverse proxies on Render.
TRUST_PROXY_HOPS=
# Public frontend setting. Local tests must use the local/test backend.
VITE_API_BASE_URL=http://localhost:3000
